Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"p", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}]}], "]"}], "+", " ", "\[Alpha]"}], 
     ")"}], " ", "==", " ", 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "+", "\[CapitalDelta]"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"(", 
         RowBox[{"p", "+", "\[CapitalDelta]"}], ")"}]}], ")"}]}], "]"}]}], ",",
    " ", "\[CapitalDelta]"}], "]"}]], "Input",
 CellChangeTimes->{{3.981863033493185*^9, 3.98186303449262*^9}, {
  3.9818636882061357`*^9, 3.981863690470333*^9}, {3.981863730585155*^9, 
  3.981863753578959*^9}},
