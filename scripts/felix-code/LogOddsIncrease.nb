 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Calculate", " ", "percent", " ", "correct", " ", "from", " ", 
    RowBox[{"d", "'"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"pC", "[", "x_", "]"}], ":=", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{"CDF", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"x", ",", "1"}], "]"}], ",", " ", 
