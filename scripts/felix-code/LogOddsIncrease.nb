Cell[BoxData[
 RowBox[{
  RowBox[{"dP", "[", "x_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"InverseCDF", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}], ",", " ", "x"}], "]"}], "-", 
   RowBox[{"InverseCDF", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}], ",", " ", 
     RowBox[{"1", "-", "x"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.982118186954459*^9, 3.982118207157761*^9}},
 CellLabel->
  "In[268]:=",ExpressionUUID->"9327fc3f-4ac3-4ea3-bce4-f576e41bd7db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
