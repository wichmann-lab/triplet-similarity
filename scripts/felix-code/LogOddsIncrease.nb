}, Open  ]],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "Translate", " ", "the", " ", "above", " ", "condtion", " ", "into", " ", 
   "a", " ", "constant", " ", "fraction", " ", "of", " ", "resolved"}], " ", 
  "*)"}]], "Input",
 CellChangeTimes->{{3.982147264362962*^9, 3.9821472785053062`*^9}},
 CellLabel->
  "In[265]:=",ExpressionUUID->"da0dd95b-e973-4749-b192-0fd1bc412bec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fractionOffset", " ", "=", " ", 
  RowBox[{"myDelta", "/", 
   RowBox[{"(", 
    RowBox[{"1", "-", "myP"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.982147391018449*^9, 3.982147410307652*^9}},
