   RowBox[{"dP", "[", "x", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0.5", ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<p\>\"", ",", "\"\<d prime\>\""}], "}"}]}]}], "]"}]], "Input",\

