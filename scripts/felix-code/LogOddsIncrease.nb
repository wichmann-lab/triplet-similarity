Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"\[CapitalDelta]", "\[Rule]", 
    TemplateBox[{
      FractionBox[
       RowBox[{
         RowBox[{"-", "p"}], "+", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[ExponentialE]", "\[Alpha]"], " ", "p"}], 
          RowBox[{"1", "-", "p"}]], "-", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[ExponentialE]", "\[Alpha]"], " ", 
            SuperscriptBox["p", "2"]}], 
          RowBox[{"1", "-", "p"}]]}], 
       RowBox[{"1", "+", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[ExponentialE]", "\[Alpha]"], " ", "p"}], 
          RowBox[{"1", "-", "p"}]]}]], 
      RowBox[{
        RowBox[{"-", "\[Pi]"}], "<", 
        RowBox[{"Im", "[", 
          RowBox[{"\[Alpha]", "+", 
            RowBox[{"Log", "[", 
              FractionBox["p", 
               RowBox[{"1", "-", "p"}]], "]"}]}], "]"}], "\[LessEqual]", 
        "\[Pi]"}]},
     "ConditionalExpression"]}], "}"}], "}"}]], "Output",
