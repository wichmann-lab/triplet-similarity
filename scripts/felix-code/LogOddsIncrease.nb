Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Calculate", " ", 
   RowBox[{"d", "'"}], " ", "for", " ", "the", " ", "optimal", " ", "YesNo", " ",
    "observer", " ", "as", " ", "a", " ", "function", " ", "of", " ", 
