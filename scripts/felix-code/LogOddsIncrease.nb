Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Clear", " ", "alpha"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\[Alpha]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Solve", " ", "the", " ", "equation"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solution", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"p", "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", "p"}], ")"}]}], "]"}], "+", "\[Alpha]"}], "==", 
        
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"p", "+", "\[CapitalDelta]"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"(", 
             RowBox[{"p", "+", "\[CapitalDelta]"}], ")"}]}], ")"}]}], "]"}]}],
        ",", "\[CapitalDelta]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Extract", " ", "the", " ", "expression", " ", "for", " ", 
     "\[CapitalDelta]"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deltaExpr", "=", 
     RowBox[{"\[CapitalDelta]", " ", "/.", " ", "solution"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Plot", " ", "the", " ", "expression", " ", "for", " ", "\[CapitalDelta]",
      " ", "as", " ", "a", " ", "function", " ", "of", " ", "p"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"deltaExpr", " ", "/.", " ", 
       RowBox[{"\[Alpha]", "->", "logOddsOffset"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", "0.5", ",", "1"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", 
        ",", "\"\<\[CapitalDelta]p for constant LogOdd increment\>\""}], 
       "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.981863585757605*^9, 3.9818635877053747`*^9}, {
   3.98186362472541*^9, 3.981863624816256*^9}, {3.981863767586754*^9, 
